{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ENGINE_BUILD_GAME": "ON",
        "ENGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "msvc",
      "inherits": "base",
      "displayName": "MSVC x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-gcc",
      "inherits": "base",
      "displayName": "Ninja + GCC (Debug)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ninja-clang",
      "inherits": "base",
      "displayName": "Ninja + Clang (Debug)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ninja-asan",
      "inherits": "base",
      "displayName": "Ninja + GCC (Debug, ASan + UBSan)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "ENGINE_SANITIZE": "ON"
      }
    },
    {
      "name": "ninja-bench",
      "displayName": "Ninja + GCC (Release, benchmarks only)",
      "description": "Optimized build of the engine and engine_benchmarks; the game and tests are skipped.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "ENGINE_BUILD_GAME": "OFF",
        "ENGINE_BUILD_TESTS": "OFF",
        "ENGINE_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "configurePreset": "msvc",
      "nativeToolOptions": ["/m"],
      "description": "/m lets MSBuild build independent projects at the same time, one per core."
    },
    { "name": "debug",       "inherits": "msvc-base", "configuration": "Debug" },
    { "name": "release",     "inherits": "msvc-base", "configuration": "Release" },
    { "name": "ninja-gcc",   "configurePreset": "ninja-gcc" },
    { "name": "ninja-clang", "configurePreset": "ninja-clang" },
    { "name": "ninja-asan",  "configurePreset": "ninja-asan" },
    {
      "name": "bench",
      "inherits": "msvc-base",
      "configuration": "Release",
      "targets": ["engine_benchmarks"],
      "description": "Release build of engine_benchmarks with the msvc configure preset."
    },
    { "name": "ninja-bench", "configurePreset": "ninja-bench", "targets": ["engine_benchmarks"] }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "debug",       "inherits": "test-base", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "release",     "inherits": "test-base", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "ninja-gcc",   "inherits": "test-base", "configurePreset": "ninja-gcc" },
    { "name": "ninja-clang", "inherits": "test-base", "configurePreset": "ninja-clang" },
    { "name": "ninja-asan",  "inherits": "test-base", "configurePreset": "ninja-asan" }
  ]
}
