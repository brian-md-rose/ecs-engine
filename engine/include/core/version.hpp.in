// Versions follow Semantic Versioning; see CHANGELOG.md.

#define ENGINE_VERSION_MAJOR @EcsEngine_VERSION_MAJOR@
#define ENGINE_VERSION_MINOR @EcsEngine_VERSION_MINOR@
#define ENGINE_VERSION_PATCH @EcsEngine_VERSION_PATCH@

namespace engine
{
	inline constexpr int kVersionMajor = ENGINE_VERSION_MAJOR;
	inline constexpr int kVersionMinor = ENGINE_VERSION_MINOR;
	inline constexpr int kVersionPatch = ENGINE_VERSION_PATCH;

	// "major.minor.patch", e.g. "0.1.0".
	inline constexpr const char* kVersionString = "@EcsEngine_VERSION@";
} // namespace engine
